# ─────────────────────────────────────────────
#  HireMind AI Backend — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
PROJECT_NAME=HireMind AI Backend
VERSION=1.0.0

# ── Security ─────────────────────────────────
# Generate a strong key:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE-ME-GENERATE-A-SECURE-KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_SIZE=5242880

# ── SMTP / Email ─────────────────────────────
# Leave empty to skip sending (OTP stored but email not delivered)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@hiremind.ai
SMTP_USE_TLS=true

# ── OTP ──────────────────────────────────────
OTP_EXPIRE_MINUTES=10

# ── MongoDB ──────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=hiremind_ai

# ── AI Keys ──────────────────────────────────
GROQ_API_KEY=
GOOGLE_API_KEY=
CHROMA_PERSIST_DIRECTORY=./chroma_db
